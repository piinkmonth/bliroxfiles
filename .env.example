# copy to .env.local (dev) or .env.production (live) and fill in.
# paste values WITHOUT surrounding <angle brackets> or "quotes".

# --- storage -----------------------------------------------------------------
# must be on the uploads drive. the app refuses to start if this lands on the
# same filesystem as /, so uploads can never fill the OS disk.
BLIROX_STORAGE_ROOT=/mnt/blirox-files/BliroxUpload

# --- public urls -------------------------------------------------------------
BLIROX_PUBLIC_ORIGIN=https://files.example.com
BLIROX_CDN_ORIGIN=https://us01.example.com
BLIROX_APP_HOST=files.example.com
BLIROX_CDN_HOSTS=us01.example.com

# developer api + docs. served from this host by the same app process (next
# rewrites route it — see next.config.js). point a DNS record + tunnel/proxy
# entry for this host at the app, and give it its own TLS cert/SAN.
BLIROX_API_HOST=api.example.com
BLIROX_API_ORIGIN=https://api.example.com

# biggest one-shot api upload (POST /v1/files), in MB. stays under the tunnel's
# 100mb body cap; bigger files use the chunked flow.
BLIROX_API_ONESHOT_MB=90

# --- encryption at rest ------------------------------------------------------
# encrypts stored IP addresses. generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACK THIS UP. lose it and existing encrypted values are unreadable forever.
BLIROX_ENCRYPTION_KEY=

# --- limits ------------------------------------------------------------------
BLIROX_DEFAULT_QUOTA_GB=45
BLIROX_MAX_FILE_GB=15
BLIROX_CHUNK_MB=64
BLIROX_MAX_CONCURRENT_UPLOADS=8

# egress.
#
# BUDGET is the ceiling across all downloads at once — set it to ~two-thirds of
# your measured upstream so downloads never starve the rest of your network. on
# wifi go lower still: the medium is half-duplex, so outbound bytes cost airtime
# that inbound uploads need.
#
# DOWNLOAD_KBPS is a per-connection cap, not a fixed rate. each download runs at
# the smaller of it and its share of the budget, so one person alone can use the
# whole budget instead of being pinned to a slice of an idle link.
BLIROX_EGRESS_BUDGET_KBPS=9000
BLIROX_DOWNLOAD_KBPS=9000
BLIROX_MAX_CONCURRENT_DOWNLOADS=8

# --- google sign-in (optional) -----------------------------------------------
# https://console.cloud.google.com/apis/credentials — web application client.
# redirect URI must match exactly, e.g.
#   https://files.example.com/api/auth/google/callback
#   http://localhost:4001/api/auth/google/callback   (local testing)
BLIROX_GOOGLE_CLIENT_ID=
BLIROX_GOOGLE_CLIENT_SECRET=
# BLIROX_GOOGLE_REDIRECT_URI=

# --- malware scanning (optional) ---------------------------------------------
# clamav over tcp. needs `TCPSocket 3310` in /etc/clamav/clamd.conf.
BLIROX_CLAMAV_ENABLED=0
BLIROX_CLAMAV_HOST=127.0.0.1
BLIROX_CLAMAV_PORT=3310
BLIROX_CLAMAV_MAX_MB=512

# virustotal sends only the SHA-256, never file content.
BLIROX_VIRUSTOTAL_KEY=

# --- dev only ----------------------------------------------------------------
# bypasses the mounted-drive safety check. NEVER set this on the server.
# BLIROX_ALLOW_UNMOUNTED=1
